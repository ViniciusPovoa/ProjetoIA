APP_ENV=production
APP_DEBUG=false
APP_URL=https://seudominio.com.br
FRONTEND_URL=https://seudominio.com.br
APP_NAME=EquipeAI
APP_TIMEZONE=America/Sao_Paulo

DB_HOST=localhost
DB_PORT=3306
DB_NAME=equipeai
DB_USER=equipeai_user
DB_PASSWORD=

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=

MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_ENCRYPTION=tls
MAIL_FROM=no-reply@seudominio.com.br
MAIL_FROM_NAME=EquipeAI

MAX_UPLOAD_MB=10
SESSION_DAYS=30
USD_BRL_RATE=5.50
LOG_RETENTION_DAYS=30

# Cadastro / e-mail transacional
EMAIL_VERIFY_MINUTES=60
TERMS_VERSION=2026-09
MAIL_SUPPORT=suporte@seudominio.com.br

# Image generation (Marketing v3.3)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_AI_MODEL=@cf/black-forest-labs/flux-1-schnell
CLOUDFLARE_AI_FALLBACK_MODEL=@cf/bytedance/stable-diffusion-xl-lightning
MARKETING_IMAGE_CREDIT_COST=4

# Visual prompt planner (v3.5)
# Uses the same text provider/model configured for the Marketing agent to turn the selected post into a literal image brief before Cloudflare.
IMAGE_PROMPT_ENHANCER_ENABLED=true
IMAGE_PROMPT_MAX_TOKENS=320

# Proposal delivery via WhatsApp Cloud API
WHATSAPP_CLOUD_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_VERSION=v26.0
# Optional approved template with DOCUMENT header for conversations outside the 24h service window.
WHATSAPP_PROPOSAL_TEMPLATE_NAME=
WHATSAPP_PROPOSAL_TEMPLATE_LANGUAGE=pt_BR

# Criptografia de tokens de integrações externas (64 chars hex recomendado)
APP_ENCRYPTION_KEY=

# Instagram API with Instagram Login
META_INSTAGRAM_APP_ID=
META_INSTAGRAM_APP_SECRET=
META_INSTAGRAM_REDIRECT_URI=https://api-ia.vpdeveloper.com.br/api/integrations/instagram/callback
META_INSTAGRAM_GRAPH_VERSION=v26.0

# WhatsApp Embedded Signup — cada empresa conecta o próprio número
META_WHATSAPP_APP_ID=
META_WHATSAPP_APP_SECRET=
META_WHATSAPP_CONFIG_ID=
META_WHATSAPP_GRAPH_VERSION=v26.0
# Para manter o mesmo número no app WhatsApp Business via coexistência, configure conforme sua configuração Meta.
META_WHATSAPP_EMBEDDED_FEATURE_TYPE=
META_WHATSAPP_EMBEDDED_SIGNUP_VERSION=v4

# Lila — assistente do workspace (opcional)
# Se vazio, usa o modelo OpenAI ativo mais econômico cadastrado no painel.
LILA_MODEL=
LILA_MAX_TOKENS=700
